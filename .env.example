# Copy to .env and fill in. All keys are prefixed KT_.

# --- LLM -------------------------------------------------------------------
# Default: Anthropic Claude.
KT_LLM_PROVIDER=anthropic
KT_LLM_MODEL=claude-haiku-4-5
KT_LLM_MODEL_HEAVY=claude-sonnet-4-5
KT_ANTHROPIC_API_KEY=

# Free / self-hosted alternative: anything OpenAI-compatible
# (OpenRouter, omniroute, opencode, Ollama at http://localhost:11434/v1, LM Studio).
# KT_LLM_PROVIDER=openai_compat
# KT_LLM_BASE_URL=https://openrouter.ai/api/v1
# KT_LLM_API_KEY=
# KT_LLM_MODEL=meta-llama/llama-3.3-70b-instruct

# --- Embeddings ----------------------------------------------------------
# Default: local fastembed (ONNX, no torch, no API cost, offline).
KT_EMBEDDING_PROVIDER=fastembed
KT_EMBEDDING_MODEL=intfloat/multilingual-e5-small
KT_EMBEDDING_DIM=384
# Bigger/better: intfloat/multilingual-e5-large (KT_EMBEDDING_DIM=1024)
# Tests / offline fallback: KT_EMBEDDING_PROVIDER=hashing

# --- Reranker (optional; first run downloads the model) -----------------
KT_RERANK_ENABLED=false
KT_RERANK_MODEL=jinaai/jina-reranker-v2-base-multilingual

# --- Evidence gate thresholds (calibrate with eval/run_eval.py) ---------
KT_GATE_MIN_TOP_SCORE=0.78
KT_GATE_SUPPORT_FLOOR=0.72
KT_GATE_MIN_SUPPORTING=1
KT_GATE_USE_LLM_CLASSIFIER=true
